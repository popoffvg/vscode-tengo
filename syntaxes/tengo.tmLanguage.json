{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tengo",
  "scopeName": "source.tengo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tengo",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tengo",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tengo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tengo",
              "match": "\\\\(?:[abfnrtv\\\\'\"/0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{3})"
            }
          ]
        },
        {
          "name": "string.quoted.raw.tengo",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.single.tengo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tengo",
              "match": "\\\\(?:[abfnrtv\\\\'\"/0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{3})"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tengo",
          "match": "\\b(?:if|else|for|in|return|break|continue|export)\\b"
        },
        {
          "name": "keyword.declaration.tengo",
          "match": "\\b(?:var|func)\\b"
        },
        {
          "name": "keyword.import.tengo",
          "match": "\\b(?:import)\\b"
        },
        {
          "name": "constant.language.boolean.tengo",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.undefined.tengo",
          "match": "\\bundefined\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tengo",
          "match": "\\b(?:len|append|copy|delete|splice|type_name|string|int|float|char|bool|bytes|error|time|is_string|is_bool|is_float|is_char|is_bytes|is_error|is_undefined|is_function|is_callable|is_array|is_immutable_array|is_map|is_iterable|is_time|print|printf|sprintf|format|to_json|from_json)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tengo",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.tengo",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.binary.tengo",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.tengo",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.tengo",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.tengo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.tengo",
          "match": ":=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|&\\^=|<<=|>>=|="
        },
        {
          "name": "keyword.operator.comparison.tengo",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.tengo",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.tengo",
          "match": "\\+\\+|--|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.tengo",
          "match": "&\\^|<<|>>|&|\\||\\^"
        },
        {
          "name": "keyword.operator.ternary.tengo",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.spread.tengo",
          "match": "\\.\\.\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.tengo",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.tengo" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.tengo",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
